#!/bin/bash  --login
#SBATCH --job-name karan_fastp_cleaning
#SBATCH --time=2:50:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=50G
#SBATCH --mail-type=FAIL
#SBATCH --mail-type=END
#SBATCH --array=1-92%10
#SBATCH --output=/mnt/gs21/scratch/maheymoh/karan_project_jgi/logs/slurm_logs/fastp-%A_%a.out
# this script is first step of trimming and qc of raw data
# fastp is used for this 

# setting the working directory
data="/mnt/gs21/scratch/maheymoh/karan_project_jgi"

# setting the conda env
source /mnt/home/maheymoh/miniconda3/bin/activate
conda activate variants

# changing directory to raw_data files
cd ${data}/raw_data

# making directory for cleaned reads
mkdir -p ${data}/cleaned_files
mkdir -p ${data}/cleaned_files/qc
mkdir -p ${data}/logs/slurm_logs

# this is to make list of the raw files
#printf '%s\n' * | grep '_R1\.fastq\.gz' > samples.list

# this just keep the first name and removes everything else
#sed -i 's/\(.*\)_R1\.fastq\.gz\1//' samples.list
# assiging name to the array task ID
file=$(sed -n "${SLURM_ARRAY_TASK_ID}p" ${data}/samples.list)

# printing the file name for debugging
echo "======================================"                                                                                                         
echo "    THIS LOG BELONGS TO: ${file}      "                                                                                                         
echo "======================================" 

# setting the input files name
IN_R1=$(ls ${data}/raw_data/${file}_S*_R1.fastq.gz) 
IN_R2=$(ls ${data}/raw_data/${file}_S*_R2.fastq.gz)

# running the fastp
fastp -i ${IN_R1} -I ${IN_R2} \
      -o ${data}/cleaned_files/${file}_R1.fastq \
      -O ${data}/cleaned_files/${file}_R2.fastq \
      -w 12 \
      --failed_out ${data}/cleaned_files/fail_${file}.fq \
      -j ${data}/cleaned_files/qc/${file}_fastp.json \
      -h ${data}/cleaned_files/qc/${file}_fastp.html

echo "Processing for ${file} is complete"

# renaming the slurm IDs
cp ${data}/logs/slurm_logs/fastp-${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.out ${data}/logs/slurm_logs/fastp_${file}.out 
